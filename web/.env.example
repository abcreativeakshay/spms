# Web client environment
# Point this at the API; when unset the app uses http://localhost:8080/api/v1.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional: enable Firebase email/password sign-in.
# Leave blank to use development tokens (dev:<uid>) with USE_FIREBASE=false.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
