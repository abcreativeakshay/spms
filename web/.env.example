# Web client environment. Copy to web/.env (scripts/setup_local.py does this for you).
#
# The Firebase values below are public client identifiers: they are shipped in the
# browser bundle by design. They are not secrets. The service-account key is a secret
# and lives in ../secrets/ (git-ignored), never here.
#
# Leave VITE_API_BASE_URL unset for local dev: the client calls /api/v1 and Vite's dev
# server proxies it to VITE_PROXY_TARGET, so there is no cross-origin request.
# Set it for a production build, e.g. https://api.example.com/api/v1.
# VITE_API_BASE_URL=

VITE_PROXY_TARGET=http://localhost:8080

# Firebase project: placement-app-144e3
VITE_FIREBASE_API_KEY=AIzaSyCRPybsCLdSVdoAno_kviDxr0RYEGlUcqw
VITE_FIREBASE_AUTH_DOMAIN=placement-app-144e3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=placement-app-144e3
VITE_FIREBASE_STORAGE_BUCKET=placement-app-144e3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=378168042090
VITE_FIREBASE_APP_ID=1:378168042090:web:6dc9f237b4bb3f79dee013
