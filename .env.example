# Copy to .env and fill in for real Firebase projects.
APP_NAME=SPMS
ENV=development
DEBUG=true

# false = in-memory store + fake token verifier fallback (local dev/tests only)
USE_FIREBASE=false

# Firebase project + service account.
# In production mount the JSON via Secret Manager and point this at the file.
FIREBASE_PROJECT_ID=spms-demo
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Alternative for hosts without a writable secret file (Render, Fly, Cloud Run):
# the service-account JSON itself, or its base64, in a single environment variable.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# If the host caps environment value length (it truncates the key mid-file), split the
# same JSON across numbered parts; they are concatenated in order.
# GOOGLE_APPLICATION_CREDENTIALS_JSON_1=
# GOOGLE_APPLICATION_CREDENTIALS_JSON_2=
FIREBASE_STORAGE_BUCKET=spms-demo.appspot.com

# Emulator hosts (uncomment when running `firebase emulators:start`)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Verify ID tokens against Firebase's revocation list. Off by default: it adds a
# round-trip to Identity Toolkit on every authenticated request.
FIREBASE_CHECK_REVOKED=false

# Read-through cache in front of Firestore, in seconds. 0 disables it.
# Entries stay fresh for this long; after that a stale entry is still served
# immediately while one background task refreshes it. Writes through the API
# invalidate the affected collections synchronously.
FIRESTORE_CACHE_TTL_SECONDS=30

# Warm colleges/batches/companies/drives at startup so the first screen is fast.
FIRESTORE_WARM_CACHE=true

# CORS: comma separated origins for the web client
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Signed URL lifetime (seconds) for resumes / offer letters
SIGNED_URL_TTL_SECONDS=900

# Business defaults
DEFAULT_MIN_ATTENDANCE_PCT=75
ATTENDANCE_CORRECTION_WINDOW_DAYS=7
PROFILE_COMPLETENESS_THRESHOLD=70
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# Readiness weights (must sum to 1.0)
READINESS_WEIGHT_ATTENDANCE=0.20
READINESS_WEIGHT_ASSESSMENT=0.40
READINESS_WEIGHT_INTERVIEW=0.30
READINESS_WEIGHT_PROFILE=0.10

# Email (Firebase Trigger Email extension writes to `mail`; SMTP optional)
EMAIL_ENABLED=false
EMAIL_FROM=placements@example.edu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed/dev convenience: allow the fake verifier to accept `dev:<uid>` bearer tokens
ALLOW_DEV_TOKENS=false

# Populate the in-memory store with demo data on startup (USE_FIREBASE=false only).
# Sign in with dev:demo-admin / dev:demo-trainer / dev:demo-student-1.
SEED_DEMO=false
